# 默认使用本地 Ollama；可选 ollama / deepseek / glm / openai / xai
LLM_DEFAULT_PROVIDER=ollama

# 首次打开页面时创建 6-12 位访问 PIN；此处只配置会话时长
KANGJI_SESSION_HOURS=12

# 可选：测试或隔离运行时覆盖 SQLite 路径；留空即使用 ../data/kangji.sqlite3
# KANGJI_DB_PATH=../data/kangji.sqlite3

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# 可选混合 RAG；未启用或依赖缺失时自动保留 FTS5 检索
RAG_VECTOR_ENABLED=0
RAG_VECTOR_PATH=../data/qdrant
RAG_VECTOR_COLLECTION=kangji_kb
RAG_EMBED_BASE_URL=http://127.0.0.1:11434
RAG_EMBED_MODEL=qwen3-embedding:0.6b
